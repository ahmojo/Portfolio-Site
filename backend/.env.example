# -- Portfolio backend configuration -----------------------------------------
# Copy this file to ".env" and tweak. Production refuses placeholder secrets.

PORTFOLIO_ENV=development
# Maximum accepted SQLite restore upload (default: 10 MiB).
#PORTFOLIO_RESTORE_MAX_BYTES=10485760

# CORS: origins allowed to call the API (JSON list).
#PORTFOLIO_ALLOWED_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000","null"]

# GitHub repo metadata (used by /api/projects).
PORTFOLIO_GITHUB_USER=ahmojo
# Optional: a personal access token raises the rate limit 60 -> 5000/h.
#PORTFOLIO_GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
# Merged PRs in repos owned by these accounts are omitted from the public site.
# The configured GitHub user is always excluded automatically.
#PORTFOLIO_OPEN_SOURCE_EXCLUDED_OWNERS=["AleksZyro","BotondCsereklye","Momik-jpg","Geldflamme365","mikepro100223"]
#PORTFOLIO_OPEN_SOURCE_TTL=3600

# Forwarded client-IP headers are trusted only from these direct proxy peers.
# Defaults to Cloudflare's published IPv4/IPv6 ranges.
#PORTFOLIO_TRUSTED_PROXY_CIDRS=["173.245.48.0/20","103.21.244.0/22"]

# Map project titles (as shown on the site) to "user/repo".
#PORTFOLIO_PROJECTS={"Regal-Erkennung für KMU":"ahmojo/Badenhackt_KMU_Trifft_KI","Codex Claude Transfer":"ahmojo/codex-claude-transfer"}

# "Now" status - a token required to UPDATE /api/now. Leave empty for local dev.
#PORTFOLIO_NOW_TOKEN=change-me

# Optional public uptime badge. Keep the API key server-side.
#PORTFOLIO_UPTIME_ROBOT_API_KEY=ur_xxxxxxxxxxxxxxxxxxxx
#PORTFOLIO_UPTIME_ROBOT_MONITOR_ID=123456789
PORTFOLIO_UPTIME_ROBOT_STATUS_PAGE_URL=https://stats.uptimerobot.com/PFy2MRBznP
#PORTFOLIO_UPTIME_CACHE_SECONDS=300

# -- STRICT CONFIRMED-HUMAN ANALYTICS ----------------------------------------
# Production Compose enables strict mode and pins the expected hostname.
# Analytics remains fail-closed (no visits counted) until both keys are set.
# The site key is public; the secret key must exist only in backend/.env.
#PORTFOLIO_ANALYTICS_STRICT=true
#PORTFOLIO_ANALYTICS_HOSTNAME=ahmet-portfolio.ch
#PORTFOLIO_TURNSTILE_SITE_KEY=0x4AAAAAxxxxxxxxxxxxxxxx
#PORTFOLIO_TURNSTILE_SECRET_KEY=0x4AAAAAxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#PORTFOLIO_ANALYTICS_SEED_TTL_SECONDS=300
#PORTFOLIO_ANALYTICS_CONFIRM_RATE_LIMIT=8
#PORTFOLIO_ANALYTICS_CONFIRM_RATE_WINDOW_SECONDS=60

# -- ADMIN PANEL --------------------------------------------------------------
# Password for the /admin panel. CHANGE THIS before deploying.
PORTFOLIO_ADMIN_PASSWORD=change-this-before-deploy
# Generate a real random secret for production, for example:
#   openssl rand -base64 48
PORTFOLIO_SESSION_SECRET=change-this-to-a-long-random-session-secret
#PORTFOLIO_SESSION_TTL_HOURS=12
#PORTFOLIO_SECURE_COOKIES=true
#PORTFOLIO_EXPOSE_DOCS=false
